[node name="TopBar" type="PanelContainer" parent="UI/Root"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 40.0
grow_horizontal = 2

[node name="HBox" type="HBoxContainer" parent="UI/Root/TopBar"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="New" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "New empty map"
text = "New"

[node name="Open" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Open a layout (.json)"
text = "Open..."

[node name="Save" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Save the layout (.json). Ctrl+S"
text = "Save..."

[node name="Export" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Write the .vmap (and optionally compile). Ctrl+E"
text = "Export .vmap"

[node name="Sep1" type="VSeparator" parent="UI/Root/TopBar/HBox"]
layout_mode = 2

[node name="Select" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Select / drag points. Shift+drag = vertical. Ctrl+click an edge = insert point."
text = "1 Select"

[node name="Path" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Draw a corridor polyline at the working elevation."
text = "2 Path"

[node name="Floor" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Draw an extra walkable floor polygon."
text = "3 Floor"

[node name="Obstacle" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Draw a solid block (taller than 65u cannot be jumped on)."
text = "4 Obstacle"

[node name="Pit" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Draw a hole in the floor (height = depth, 0 = bottomless)."
text = "5 Pit"

[node name="SpawnT" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Place a Terrorist spawn."
text = "6 T spawn"

[node name="SpawnCT" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Place a Counter-Terrorist spawn."
text = "7 CT spawn"

[node name="Sep2" type="VSeparator" parent="UI/Root/TopBar/HBox"]
layout_mode = 2

[node name="View" type="Button" parent="UI/Root/TopBar/HBox"]
layout_mode = 2
tooltip_text = "Toggle top-down orthographic / free fly camera (Tab)"
text = "Top / Free view"

