[sub_resource type="Environment" id="Env"]
background_mode = 1
background_color = Color(0.11, 0.12, 0.14, 1)
ambient_light_source = 2
ambient_light_color = Color(0.62, 0.66, 0.75, 1)
ambient_light_energy = 0.55
tonemap_mode = 2

[node name="Main" type="Node3D" node_paths=PackedStringArray("Ui", "Rig", "Preview", "Overlay")]
script = ExtResource("1_root")
Ui = NodePath("UI/Root")
Rig = NodePath("CameraRig")
Preview = NodePath("Preview")
Overlay = NodePath("Overlay")

[node name="CameraRig" type="Node3D" parent="." node_paths=PackedStringArray("Camera")]
script = ExtResource("2_rig")
Camera = NodePath("Camera3D")

[node name="Camera3D" type="Camera3D" parent="CameraRig"]
current = true

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.81915, 0, -0.57358, -0.46985, 0.57358, -0.67101, 0.32899, 0.81915, 0.46985, 0, 0, 0)
light_energy = 1.1
shadow_enabled = true
directional_shadow_max_distance = 16000.0

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

[node name="Preview" type="Node3D" parent="."]
script = ExtResource("3_prev")
