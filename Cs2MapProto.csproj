<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Cs2MapProto</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Add-ons build as their own assemblies (see "Plugins" in README.md), never into the editor. -->
    <Compile Remove="addons/**" />
    <None Remove="addons/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Clipper2" Version="1.5.4" />
  </ItemGroup>

  <!-- Build whatever add-ons are checked out (addons/<Name>/<Name>.csproj, usually git submodules) after the editor,
       so Play in Godot picks up their changes. Missing or uninitialised submodules are simply skipped. Their
       reference back to this project is already built, so it isn't rebuilt (that would recurse).
       Godot exports (ExportDebug / ExportRelease, published per platform) skip this: plugins aren't part of an
       export, they're copied next to the exported executable (see docs/plugins.md). -->
  <Target Name="BuildAddons" AfterTargets="Build"
          Condition="'$(BuildingAddon)' != 'true' and !$(Configuration.StartsWith('Export')) and '$(_IsPublishing)' != 'true'">
    <ItemGroup>
      <AddonProject Include="$(MSBuildThisFileDirectory)addons/*/*.csproj" />
    </ItemGroup>
    <PropertyGroup>
      <AddonProperties>Configuration=$(Configuration);BuildProjectReferences=false;BuildingAddon=true</AddonProperties>
    </PropertyGroup>
    <!-- Restore runs as its own evaluation first (a fresh submodule has no assets file yet). -->
    <MSBuild Projects="@(AddonProject)" Targets="Restore" Properties="$(AddonProperties);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" Condition="'@(AddonProject)' != ''" />
    <MSBuild Projects="@(AddonProject)" Targets="Build" Properties="$(AddonProperties)" Condition="'@(AddonProject)' != ''" />
  </Target>
</Project>
